# Exact hostname, no https:// or trailing path. Copy this file to .env on the server.
POLICY_DOMAIN=research.example.com
POLICY_RELEASE=v0.2.0
# Host path, owned by uid/gid 10001 and readable only by the service and administrators.
POLICY_DATA_PATH=./data
POLICY_DNS_MODE=system
# Public IPv4 of this server; compose.opencode.yaml blocks it so research tools cannot reach the host itself.
POLICY_SERVER_IP=203.0.113.10
