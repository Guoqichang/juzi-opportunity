ARG POLICY_RELEASE=v0.2.0-server-20260924-r4
FROM node:22-bookworm-slim AS opencode
RUN npm install -g opencode-ai@1.18.29

FROM juzi-opportunity:${POLICY_RELEASE}
USER root
COPY --from=opencode /usr/local/lib/node_modules/opencode-ai/node_modules/opencode-linux-x64/bin/opencode /usr/local/bin/opencode
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/policy-browsers
RUN /app/.venv/bin/playwright install --with-deps chromium \
    && mkdir -p /research /state /opt/research/.opencode \
    && chown -R policy:policy /research /state /opt/research /opt/policy-browsers
COPY deploy/opencode/ /opt/research/
COPY deploy/opencode_start.py /app/scripts/opencode_start.py
RUN chown -R policy:policy /opt/research
ENV XDG_CONFIG_HOME=/state/config XDG_DATA_HOME=/state/data XDG_CACHE_HOME=/state/cache \
    OPENCODE_CONFIG=/run/secrets/opencode-provider.json POLICY_RESEARCH_RESULTS_DIR=/research
WORKDIR /opt/research
USER 10001:10001
CMD ["python", "/app/scripts/opencode_start.py"]
